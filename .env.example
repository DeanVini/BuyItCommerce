# Senha do usuário 'sa' do SQL Server.
# Requisitos do SQL Server: mínimo 8 caracteres, com maiúscula, minúscula, número e símbolo.
# É usada tanto pelo container do SQL Server quanto pela connection string da API (docker-compose.yml).
SA_PASSWORD=Your_password123

# Credenciais do usuário root do MongoDB.
# Usadas pelo container do MongoDB (MONGO_INITDB_ROOT_*) e pela connection string da API.
MONGO_USERNAME=buyit
MONGO_PASSWORD=Your_password123
